# Скопировать в .env. ЗНАЧЕНИЙ СЕКРЕТОВ ЗДЕСЬ БЫТЬ НЕ ДОЛЖНО.
# Файл коммитится только в этой, примерной, форме.

TBOT_TRADING_MODE=paper              # paper|live ; live - только руками (AGENTS 4.1)
TBOT_SECRETS_PATH=/app/secrets/store.bin   # путь к зашифрованному хранилищу
TBOT_DB_PATH=/app/data/tbot.db
TBOT_DASHBOARD_PORT=8080
TBOT_DASHBOARD_USER=admin
TBOT_TZ_DISPLAY=Europe/Moscow
TBOT_LOG_LEVEL=INFO

# VK: здесь только идентификатор получателя, сам токен - в зашифрованном хранилище
TBOT_VK_ALLOWED_PEER_IDS=000000000
TBOT_VK_ENABLED=true

# Прочее
TBOT_RISK_PER_TRADE=0.01             # увеличение только правкой файла человеком
TBOT_DAILY_LOSS_LIMIT=0.03
TBOT_GLOBAL_DRAWDOWN_STOP=0.15
TBOT_MAX_POSITION_PCT=0.15
TBOT_MAX_VOLUME_PARTICIPATION=0.05  # старт; калибровать по журналу

# risk_manager.py (docs/04_RISK.md, docs/07_CONFIG_SPEC.md)
TBOT_ATR_STOP_MULT=1.5
TBOT_ATR_TAKE_MULT=2.0
TBOT_ATR_TRAIL_TRIGGER=1.0
TBOT_ATR_TRAIL_DIST=1.0
TBOT_MAX_TRADES_PER_DAY=30
TBOT_MIN_FREE_BALANCE=5000
TBOT_MAX_OPEN_POSITIONS=7
TBOT_MAX_PER_SECTOR=2
TBOT_MAX_CORRELATION=0.85
TBOT_MAX_ATR_RATIO=0.05
TBOT_MAX_SPREAD_BPS=30
TBOT_VOLATILE_SIZE_SCALER=0.5
TBOT_SESSION_GUARD_MIN=10
TBOT_SLIPPAGE_ASSUMED=0.0005
TBOT_FEE_RATE=0.003

# Стрим/переподключение (docs/00_PLAN.md §8, docs/07_CONFIG_SPEC.md)
TBOT_BACKOFF_BASE_SEC=5
TBOT_BACKOFF_MAX_ATTEMPTS=10
TBOT_STREAM_RECONNECT_SEC=5

# Unary MarketData starts: shared sliding 60s budget for this gateway/process only.
# Operator-selected budget600; NOT a verified token tariff, nor control of other processes.
# Pacing starts at 0.1s; RPC latency can overlap. Quota reset cooldown is shared.
TBOT_CANDLE_MIN_INTERVAL_SEC=0.1
TBOT_CANDLE_MAX_ATTEMPTS=4
TBOT_CANDLE_RETRY_BASE_SEC=5.0
TBOT_CANDLE_MAX_RETRY_WAIT_SEC=120.0   # UNAVAILABLE elapsed only; not a quota reset cap
TBOT_CANDLE_QUOTA_MAX_ATTEMPTS=61    # quota attempts including first, min wait1s/full server reset
TBOT_MARKET_DATA_REQUESTS_PER_MINUTE=600
TBOT_LIQUIDITY_WORKERS=4            # 1..32; workers read history only, never SQLite

# strategy.py (docs/03_STRATEGY.md, docs/07_CONFIG_SPEC.md «strategy»/«Пул и фильтры»)
TBOT_EMA_FAST=9
TBOT_EMA_MID=21
TBOT_EMA_SLOW=50
TBOT_RSI_PERIOD=14
TBOT_RSI_OVERSOLD=30
TBOT_RSI_OVERBOUGHT=70
TBOT_RSI_TREND_LOW=30
TBOT_RSI_TREND_HIGH=65
TBOT_MACD_FAST=12
TBOT_MACD_SLOW=26
TBOT_MACD_SIGNAL=9
TBOT_BB_PERIOD=20
TBOT_BB_MULT=2.0
TBOT_ATR_PERIOD=14
TBOT_ADX_PERIOD=14
TBOT_ADX_TREND=25
TBOT_ADX_RANGE=20
TBOT_ADX_CHAOS=40
TBOT_VOL_WINDOW=20
TBOT_GAP_PAUSE_PCT=0.03
TBOT_GAP_PAUSE_MIN=30
TBOT_REGIME_REFRESH_MIN=30          # локальный режим: слоты от 10:00 МСК + предсессионный 09:50
# Пересмотр пула фиксирован: каждые 15 мин круглосуточно (не параметр окружения).
TBOT_BREADTH_BEARISH=0.30
TBOT_BREADTH_BULLISH=0.70

# Автоматический paper-bootstrap: токен только в OS keyring tbot/broker_token.
# Без виртуального начального баланса остаётся offline heartbeat-only.
# Задайте TBOT_PAPER_STARTING_BALANCE явно перед сетевым запуском.
# Кандидаты, пул и ID настоящего IMOEX определяются автоматически.
# TBOT_PAPER_CANDIDATE_TICKERS / TBOT_PAPER_APPROVED_TICKERS /
# TBOT_PAPER_INDEX_ID устарели и для запуска не нужны.

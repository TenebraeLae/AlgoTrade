# Скопировать в .env. ЗНАЧЕНИЙ СЕКРЕТОВ ЗДЕСЬ БЫТЬ НЕ ДОЛЖНО.
# Файл коммитится только в этой, примерной, форме.

TBOT_TRADING_MODE=paper              # paper|live ; live - только руками (AGENTS 4.1)
TBOT_SECRETS_PATH=/app/secrets/store.bin   # путь к зашифрованному хранилищу
TBOT_DB_PATH=/app/data/tbot.db
TBOT_DASHBOARD_PORT=8080
TBOT_DASHBOARD_USER=admin
TBOT_TZ_DISPLAY=Europe/Moscow
TBOT_LOG_LEVEL=INFO

# VK: здесь только идентификатор получателя, сам токен - в зашифрованном хранилище
TBOT_VK_ALLOWED_PEER_IDS=000000000
TBOT_VK_ENABLED=true

# Прочее
TBOT_RISK_PER_TRADE=0.01             # увеличение только правкой файла человеком
TBOT_DAILY_LOSS_LIMIT=0.03
